{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVP Recommends article",
  "type": "object",
  "required": [
    "id",
    "title",
    "topic",
    "readingTime",
    "byline",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "readingTime": {
      "type": "string",
      "minLength": 1
    },
    "byline": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
