  "meta": {
    "id": "charlotte",
    "fixturesVersion": "3.9",
    "scope": "C-03",
    "invented": [
      {
        "fact": "Ages",
        "decision": "Charlotte 48, Edward 50, Alexis 10 in fourth grade, Mallory 6 in kindergarten",
        "reason": "The adult ages are new."
      },
      {
        "fact": "Schools",
        "decision": "Alexis at Cedar Grove Elementary, 8:00 am to 2:45 pm, collected at the Oak Street gate. Mallory at Westview Kindergarten, 8:30 am to 2:30 pm, Room 3.",
        "reason": "The girls attend different schools, and the different hours make both the morning and the afternoon real."
      },
      {
        "fact": "Carpool",
        "decision": "Mornings only. The Parks drive Monday, the Okafors Wednesday and Charlotte Friday, with Mallory riding along on Friday to Westview.",
        "reason": "The WhatsApp message comes from Jenna Okafor, and Friday explains why Mallory leaves at 7:40 am that day."
      },
      {
        "fact": "Edward's week",
        "decision": "At the office Tuesday and Wednesday. Home Thursday, free from 1:15 pm until a 2:00 pm meeting is added on Wednesday.",
        "reason": "Thursday has to be a day Edward is home so he can be asked, and the new meeting shows an accepted item reopening."
      },
      {
        "fact": "Westview rotation",
        "decision": "A six-day letter rotation, A to F. The demo week runs B to F from Monday to Friday, which puts the Tuesday after C-00 on an E day.",
        "reason": "B, D and F are motor skills days, which is where Mallory's sneakers come from."
      },
      {
        "fact": "The parents' WhatsApp group",
        "decision": "Named \"Cedar Grove 4th Grade Parents\"",
        "reason": "Gives the C-03 reply an address line."
      },
      {
        "fact": "Her calendar",
        "decision": "Charlotte uses Google Calendar and connects it during setup in C-00. It holds Alexis's therapy at Brightwater on Mondays at 3:30 pm, Alexis's dance at Studio Ten on Wednesdays at 3:45 pm and Mallory's ballet at Studio Ten on Thursdays at 4:15 pm, each as a repeating event.",
        "reason": "Gives the coach something real to bring in at setup, and explains why those three items carry the calendar mark through the week. Google Calendar is the most common calendar to connect and the simplest to stage."
      }
    ]
  },
